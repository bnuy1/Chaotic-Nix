# Singularity host-level secrets.
#
# Steps:
# 1. Copy to secrets.yaml and fill every value below (keep YAML structure).
# 2. Encrypt: sudo nix-shell -p sops --run "SOPS_AGE_KEY_FILE=/var/lib/sops-nix/keys.txt sops --encrypt --in-place --age $(cat /etc/nixos/age_pub.txt) secrets.yaml"
# 3. nixos-rebuild switch; decrypted files land under /run/secrets at boot.

system:
    # msmtp password for system mail (ZFS ZED, cron, root) submitted to the
    # host mailcow on 127.0.0.1:587 as singularity@bnuy.dev. MUST equal the
    # mailcow/mailbox_singularity value.
    msmtp: "CHANGE_ME"
