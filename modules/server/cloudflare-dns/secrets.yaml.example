# Dynamic Cloudflare WAN-DNS updater secrets for modules/server/cloudflare-dns.
#
# Steps:
# 1. Copy to secrets.yaml and fill every value below (keep YAML structure).
# 2. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
# 3. nixos-rebuild switch; the token lands under /run/secrets/cloudflareDns/api_token.
#
# Decryption:
# sudo nix-shell -p sops --run "sops -d secrets.yaml"
#
# Token requirements: API token with Zone.DNS Edit permission for the zone
# given in services.cloudflareDns.zoneId. Create it in the Cloudflare
# dashboard: My Profile -> API Tokens -> Create Token -> "Edit zone DNS".

cloudflareDns:
    api_token: "CHANGE_ME"
