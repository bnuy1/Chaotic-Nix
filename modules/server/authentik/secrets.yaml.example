# Authentik secrets for modules/server/authentik.
#
# Steps:
# 1. Copy to secrets.yaml and fill every value below (keep YAML structure).
# 2. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
# 3. The secret must exist before a rebuild that enables the module.
#
# Generate values:
#   sudo nix-shell -p openssl --run "openssl rand -hex 24"   # postgres_password
#   sudo nix-shell -p openssl --run "openssl rand -hex 48"   # secret_key

authentik:
  # Postgres superuser password for the authentik database.
  postgres_password: "CHANGE_ME"
  # Django/authentik SECRET_KEY - long random hex.
  secret_key: "CHANGE_ME"
