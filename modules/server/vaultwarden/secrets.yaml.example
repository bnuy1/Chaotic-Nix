# Vaultwarden secrets for modules/server/vaultwarden.
#
# Steps:
# 1. Copy to secrets.yaml and fill every value below (keep YAML structure).
# 2. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
# 3. The secret must exist before a rebuild that enables the module.
#
# Decryption:
# sudo nix-shell -p sops --run "sops -decrypt --output-type yaml secrets.yaml"

vaultwarden:
  # Admin panel (/admin) token. Generate an Argon2 PHC hash:
  #   nix shell nixpkgs#vaultwarden -c vaultwarden hash
  # Paste the ENTIRE $argon2id$... string (single-quote it: $ is special in
  # double-quoted YAML).
  admin_token: 'CHANGE_ME'
  # SMTP for invites/password-reset emails (local mailcow submission on 587).
  # smtp_username = "vaultwarden@bnuy.dev"; smtp_password MUST equal the
  # mailcow/mailbox_vaultwarden value (leave both empty to run without email).
  smtp_username: "vaultwarden@bnuy.dev"
  smtp_password: "CHANGE_ME"
  # Password for this module's restic repo (/var/backups/vaultwarden/repo).
  # Long random alnum. NEVER store restic passwords inside Vaultwarden itself
  # - that would make the backup unrecoverable exactly when you need it.
  backup_password: "CHANGE_ME"
