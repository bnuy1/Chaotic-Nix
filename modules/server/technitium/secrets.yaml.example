# Technitium DNS secrets for modules/server/technitium.
#
# Steps:
# 1. Copy to secrets.yaml and fill every value below (keep YAML structure).
# 2. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
# 3. The secret must exist before a rebuild that enables the module.
#
# Decryption:
# sudo nix-shell -p sops --run "sops -decrypt --output-type yaml secrets.yaml"

technitium:
  # Admin login for the Technitium web console (127.0.0.1:5380, LAN-blocked).
  # The technitium-provision service uses it to create zones/records via the
  # REST API. If you change the password in the web UI, update this secret to
  # match or provisioning breaks.
  admin_username: "CHANGE_ME"
  admin_password: "CHANGE_ME"
