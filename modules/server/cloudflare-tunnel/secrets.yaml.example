# Steps:
# 1. Copy to secrets.yaml and fill the token (Zero Trust -> Networks ->
#    Tunnels -> singularity -> Configuration: copy the tunnel token).
# 2. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
# 3. The secret must exist before a rebuild that enables the module.
#
# Decryption:
# sudo nix-shell -p sops --run "sops -d --output-type yaml secrets.yaml"
cloudflare-tunnel:
  token: "CHANGE_ME"
