# Steps:
# 1. Edit the values below (keep YAML structure intact)
# 2. Remove / rename this file to secrets.yaml (drop .example)
# 3. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
#
# Generate an APP_KEY with:
#   nix-shell -p php --run "php -r 'echo \"base64:\" . base64_encode(random_bytes(32));'"

# Decryption: 
# sudo nix-shell -p sops --run "sops -decrypt --output-type yaml secrets.yaml" > decrypted-secrets.yaml
pterodactyl:
  restic_password: "CHANGE_ME"
  db_password: "CHANGE_ME"
  app_key: "base64:CHANGE_ME_TO_A_32BYTE_BASE64_KEY"
  cloudflared_token: "CHANGE_ME"
