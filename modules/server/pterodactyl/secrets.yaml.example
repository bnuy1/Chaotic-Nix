# Pterodactyl panel + Minecraft network secrets for modules/server/pterodactyl.
#
# Steps:
# 1. Copy to secrets.yaml and fill every value below (keep YAML structure).
# 2. Encrypt: sudo nix-shell -p sops --run "SOPS_AGE_KEY_FILE=/var/lib/sops-nix/keys.txt sops --encrypt --in-place --age age1cp66msfm2h2dkqf5h0vr67y93q3hhrv2pq578dmql5rnduf4sufsxvzuty secrets.yaml"
# 3. nixos-rebuild switch; decrypted files land under /run/secrets at boot.
#
# Decryption:
# sudo nix-shell -p sops --run "SOPS_AGE_KEY_FILE=/var/lib/sops-nix/keys.txt sops -d secrets.yaml"

pterodactyl:
    # Panel MariaDB user password (services.pterodactyl.dbUser). Long random alnum.
    db_password: "CHANGE_ME"
    # Laravel APP_KEY ("base64:..." — see comment command in git history / panel docs).
    app_key: "CHANGE_ME"
    # Root password of the minecraft-db Docker container (LuckPerms/LoriTime/
    # PlayerPoints DBs). Consumed by the mc-leaderboard systemd unit.
    mc_db_password: "CHANGE_ME"
    # Cloudflare Tunnel token (remotely-managed tunnel, Zero Trust dashboard).
    # Only required when services.pterodactyl.cloudflared.enable = true.
    cloudflared_token: "CHANGE_ME"
    # Restic repo password (/var/backups backups of the panel). Long random alnum.
    restic_password: "CHANGE_ME"
