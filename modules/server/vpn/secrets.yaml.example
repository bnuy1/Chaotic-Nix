# Steps:
# 1. Edit the values below (keep YAML structure intact)
# 2. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
#
# cloudflared_token: create a Cloudflare Tunnel in the Zero Trust dashboard
#   for vpn.bnuy.dev -> https://localhost:443 (Origin Server Name vpn.bnuy.dev,
#   nginx holds the Let's Encrypt cert). Use the token from the dashboard.
#
# admin_preauthkey: generate AFTER first boot (users admin/staff/guest are
#   auto-created). Must be a reusable key tagged tag:admin so the subnet
#   router node owns/approves the advertised routes:
#     headscale preauthkeys create --user admin --reusable --tags tag:admin
#
# Decryption:
# sudo nix-shell -p sops --run "sops -decrypt --output-type yaml secrets.yaml" > decrypted-secrets.yaml
vpn:
    cloudflared_token: "CHANGE_ME" 
    admin_preauthkey: "CHANGE_ME"
    CF_DNS_TOKEN: "CHANGE_ME"
