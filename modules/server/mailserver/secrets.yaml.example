# Mailcow secrets for modules/server/mailserver.
#
# Steps:
# 1. Copy to secrets.yaml and fill every value below (keep YAML structure).
# 2. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
# 3. The decrypted files land in /run/secrets at boot; mailcow.conf is rendered
#    from them on first boot (write-once, see module).

# Decryption: 
# sudo nix-shell -p sops --run "sops -decrypt --output-type yaml secrets.yaml" > decrypted-secrets.yaml

mailcow:
  # SQL database (mailcow DB) + root user. Long random alnum strings.
  dbpass: "CHANGE_ME"
  dbroot: "CHANGE_ME"
  # Redis (used by rspamd/sessions). Long random alnum.
  redispass: "CHANGE_ME"
  # Web UI/API key: [A-Za-z0-9-]. Must differ from the default "invalid".
  api_key: "CHANGE_ME"
  # SOGo URL encryption key: exactly 16 chars, A-Z a-z 0-9.
  sogo_key: "CHANGE_ME"
  # mailcow web UI admin login password (login: admin).
  admin_password: "CHANGE_ME"
  # Mailbox passwords (mailboxes are created on first boot by mailcow-provision).
  mailbox_bnuy: "CHANGE_ME"
  mailbox_raina: "CHANGE_ME"
  # Watchdog webhook URL (ntfy/Discord)
  watchdog_webhook: ""
  # Password for the local restic repo (/var/backups/mailcow). Long random alnum.
  backup_password: "CHANGE_ME"
