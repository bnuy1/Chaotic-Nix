#!/bin/busybox sh

/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mount -t devtmpfs none /dev

/bin/busybox mkdir -p /mnt

for arg in $(cat /proc/cmdline); do
    case "$arg" in
        squashfs_url=*)
            SQUASHFS_URL="${arg#squashfs_url=}"
            ;;
    esac
done

if [ -z "$SQUASHFS_URL" ]; then
    echo "wrapper-initrd: ERROR: squashfs_url= not found in kernel cmdline"
    echo "wrapper-initrd: Dropping to shell"
    exec /bin/busybox sh
fi

echo "wrapper-initrd: Creating tmpfs for squashfs..."
/bin/busybox mount -t tmpfs -o size=80%,mode=755 tmpfs /mnt

echo "wrapper-initrd: Downloading squashfs from $SQUASHFS_URL..."
/bin/busybox wget -q --ca-certificate=/etc/ssl/certs/ca-certificates.crt -O /mnt/root.squashfs "$SQUASHFS_URL"
DOWNLOAD_EXIT=$?

if [ "$DOWNLOAD_EXIT" -ne 0 ]; then
    echo "wrapper-initrd: ERROR: wget failed with exit code $DOWNLOAD_EXIT"
    echo "wrapper-initrd: Dropping to shell"
    exec /bin/busybox sh
fi

if [ ! -f /mnt/root.squashfs ]; then
    echo "wrapper-initrd: ERROR: Download failed - no file at /mnt/root.squashfs"
    exec /bin/busybox sh
fi

echo "wrapper-initrd: Mounting squashfs..."
/bin/busybox mkdir -p /mnt/root
/bin/busybox mount -t squashfs -o loop,ro /mnt/root.squashfs /mnt/root
MOUNT_EXIT=$?

if [ "$MOUNT_EXIT" -ne 0 ]; then
    echo "wrapper-initrd: ERROR: Failed to mount squashfs (exit $MOUNT_EXIT)"
    echo "wrapper-initrd: Dropping to shell"
    exec /bin/busybox sh
fi

echo "wrapper-initrd: switch_root into squashfs..."
exec /bin/busybox switch_root /mnt/root /sbin/init
