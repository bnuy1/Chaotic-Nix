# step-ca secrets for modules/server/step-ca.
#
# Steps:
# 1. Copy to secrets.yaml and fill every value below (keep YAML structure).
# 2. Encrypt: sudo nix-shell -p sops --run "sops --encrypt --in-place secrets.yaml"
# 3. The secret must exist before a rebuild that enables the module.
#
# Decryption:
# sudo nix-shell -p sops --run "sops -decrypt --output-type yaml secrets.yaml"

step-ca:
  # Password for the CA intermediate key + the `admin` provisioner's
  # encryptedKey (services.step-ca.intermediatePasswordFile). Long random.
  #
  # Shared credential: the <module>-cert units of other server modules
  # (pterodactyl, netboot, vpn/headscale, vaultwarden) read this same secret
  # via group access to issue their leaf certs. Rotating it means re-encrypting
  # the provisioner key too (`step ca crypto change-pass`), not just this file.
  password: "CHANGE_ME"

  # Restic repo password for the nightly step-ca-backup
  # (/var/backups/step-ca/repo: CA keys, config, cert accounting db).
  backup_password: "CHANGE_ME"
